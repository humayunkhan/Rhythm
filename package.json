{
  "name": "rhythm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "train": "tsx scripts/train.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply rhythm --local",
    "db:migrate:remote": "wrangler d1 migrations apply rhythm --remote",
    "pages:dev": "npm run build && npm run db:migrate:local && wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
